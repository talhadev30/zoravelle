# Required database connection
MONGODB_URI=

# Public site URL for production SEO canonicals, sitemap.xml, and OpenGraph (e.g., https://zoravelle.com)
NEXT_PUBLIC_SITE_URL=

# Web3Forms contact form access key (public in browser submissions)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the exact callback URL registered with Google for this environment.
GOOGLE_REDIRECT_URI=

# Optional Cloudflare Workers AI image editing and virtual try-on
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_EDIT_PROMPT=

# Optional ImageKit server-side uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# If true, upload the original image when AI enhancement fails
IMAGE_PROCESSING_FALLBACK=false